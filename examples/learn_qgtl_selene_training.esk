(require learn)

(define hierarchy-space (hyperbolic-space 2))
(define concept-space (spherical-space 2))

(define amplitudes '(1.0 2.0 0.5))
(define probabilities (born-probabilities amplitudes))

(define backend
  (simulator-learn-backend
   'moonlab-prototype
   ':capabilities '(manifold-training born-sampling qgtl-prototype)))

(define optimizer
  (riemannian-sgd-optimizer (euclidean-space 1)
                            ':lr 0.2
                            ':max-iter 30))

(define (objective params)
  (* (- (vector-ref params 0) 1.5)
     (- (vector-ref params 0) 1.5)))

(define fitted-param
  (optimizer-minimize optimizer objective (vector 0.0)))

(display "backend: ")
(display (learn-backend-summary backend))
(newline)

(display "born probabilities: ")
(display probabilities)
(newline)

(display "born sample: ")
(display (born-sample amplitudes
                      ':values '(hierarchy cluster local)
                      ':seed 1))
(newline)

(display "riemannian fit: ")
(display fitted-param)
(newline)

(display "hyperbolic diagnostics: ")
(display (geometry-summary hierarchy-space '((0.05 0.10) (0.20 0.10))))
(newline)

(display "spherical step: ")
(display (riemannian-step concept-space
                          (vector 1.0 0.0)
                          (vector 0.5 -1.0)
                          0.1))
(newline)
